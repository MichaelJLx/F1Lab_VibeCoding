{
  "name": "formula-one-simulator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "model:build": "node scripts/vehicles/prepare-model.mjs",
    "test": "node --test tests/*/*.test.mjs",
    "rig:build": "node scripts/vehicles/build-wheel-rig.mjs",
    "test:circuits": "node tests/runners/run-circuits.mjs",
    "test:reference": "node tests/runners/run-reference-lap.mjs",
    "tracks:build": "node scripts/circuits/build-circuits.mjs",
    "tracks:check": "node scripts/circuits/build-circuits.mjs --check"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.2.0",
    "@gltf-transform/extensions": "^4.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "gltf-validator": "^2.0.0-dev.3.10",
    "meshoptimizer": "^0.24.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
